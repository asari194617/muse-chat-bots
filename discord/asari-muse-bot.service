[Unit]
Description=asari-muse Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/asari-muse
EnvironmentFile=%h/asari-muse/.env
ExecStart=%h/asari-muse/.venv/bin/python %h/asari-muse/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
